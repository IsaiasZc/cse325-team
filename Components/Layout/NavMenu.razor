@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-dark inventory-navbar">

    <div class="container-fluid px-4">


        <a class="navbar-brand fw-bold company-brand"
           href="/">

            <span class="brand-icon">📦</span>

            <span>Market Inventory</span>

        </a>


       

        <button class="navbar-toggler border-0"
                type="button"
                @onclick="ToggleMenu"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>


      

        <div class="@(menuOpen ? "navbar-collapse show" : "navbar-collapse collapse")">

            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">

                <AuthorizeView>

                    <Authorized>

                     

                        <li class="nav-item">

                            <NavLink class="nav-link"
                                     href="/"
                                     Match="NavLinkMatch.All"
                                     ActiveClass="active-page">

                                Home

                            </NavLink>

                        </li>


                       

                        <li class="nav-item">

                            <NavLink class="nav-link"
                                     href="/transfers"
                                     ActiveClass="active-page">

                                Transfer List

                            </NavLink>

                        </li>


                        

                        <AuthorizeView Roles="@Roles.Administrator"
                                      Context="adminContext">

                            <li class="nav-item">

                                <NavLink class="nav-link"
                                         href="/users"
                                         ActiveClass="active-page">

                                    Users

                                </NavLink>

                            </li>

                        </AuthorizeView>


                        <!-- Logout -->

                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">

                            <a class="btn btn-danger logout-btn"
                               href="/logout">

                                Logout

                            </a>

                        </li>

                    </Authorized>


                    <NotAuthorized>

                        <li class="nav-item mt-2 mt-lg-0">

                            <NavLink class="btn btn-primary login-btn"
                                     href="/login"
                                     ActiveClass="active-login">

                                Login

                            </NavLink>

                        </li>

                    </NotAuthorized>

                </AuthorizeView>

            </ul>

        </div>

    </div>

</nav>


@code {

    private bool menuOpen = false;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

}