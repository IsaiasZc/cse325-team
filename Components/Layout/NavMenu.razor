@rendermode InteractiveServer

<div>
    <div>
        <a class="company-name" href="">Market Inventory Application</a>
    </div>
</div>
<div>
    <nav class="navegation">
        <button class="hamburger" @onclick="ToggleMenu">
            ☰
        </button>
        <div class="nav-menu @(menuOpen ? "open" : "")">
            <AuthorizeView>
                <Authorized>
                    <div>
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <span aria-hidden="false"></span> Home
                        </NavLink>
                    </div>
                    <AuthorizeView Roles="@Roles.Administrator" Context="adminContext">
                        <div>
                            <NavLink class="nav-link" href="users">
                                <span aria-hidden="false"></span> Users
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <div>
                        <a class="nav-link" href="logout">Logout</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div>
                        <NavLink class="nav-link" href="login">
                            <span aria-hidden="false"></span> Login
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    private bool menuOpen = false;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }
}
