@page "/users"
@attribute [Authorize(Roles = "Administrator")]
@inject AuthService AuthService

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<h2>Create User</h2>

@if (message != null)
{
    <p class="@(isError ? "text-danger" : "text-success")">@message</p>
}

<EditForm Model="createModel" method="post" FormName="createUser">
    <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <InputText id="username" class="form-control" @bind-Value="createModel.Name" autocomplete="off" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" class="form-control" type="password" @bind-Value="createModel.Password" autocomplete="new-password" />
    </div>
    <div class="mb-3">
        <label for="role" class="form-label">Role</label>
        <InputSelect id="role" class="form-select" @bind-Value="createModel.Level">
            <option value="2">Administrator</option>
            <option value="1">User</option>
        </InputSelect>
    </div>
    <button type="submit" class="btn btn-primary">Create User</button>
</EditForm>

<h2>Existing Users</h2>

@if (users != null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (User user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.RoleName</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromForm]
    private CreateUserModel createModel { get; set; } = new();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private List<User>? users;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        if (HttpContext.Request.Method == HttpMethods.Post)
        {
            var result = await AuthService.CreateUserAsync(createModel.Name ?? "", createModel.Password ?? "", createModel.Level);
            isError = !result.Success;
            message = result.Success ? $"User '{createModel.Name}' created." : result.Error;
        }

        users = await AuthService.ListUsersAsync();
    }

    private class CreateUserModel
    {
        public string? Name { get; set; }
        public string? Password { get; set; }
        public int Level { get; set; } = 1;
    }
}
