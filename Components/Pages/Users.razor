@page "/users"
@attribute [Authorize(Roles = "Administrator")]
@inject AuthService AuthService

<PageTitle>Users</PageTitle>

<div class="container-fluid py-4">


    <div class="mb-4">

        <h1 class="fw-bold text-dark">
            User Management
        </h1>

        <p class="text-muted">
            Create and manage application users and permissions.
        </p>

    </div>



    

    <div class="card shadow-sm border-0 rounded-4 mb-5">

        <div class="card-body p-4">


            <h2 class="fw-semibold mb-4">
                Create User
            </h2>



            @if (message != null)
            {
                <div class="alert @(isError ? "alert-danger" : "alert-success") rounded-3">
                    @message
                </div>
            }



            <EditForm Model="createModel"
                      method="post"
                      FormName="createUser">


                <div class="row g-3">


                    <div class="col-md-6">

                        <label for="username"
                               class="form-label fw-semibold">

                            Username

                        </label>


                        <InputText id="username"
                                   class="form-control rounded-3"
                                   @bind-Value="createModel.Name"
                                   autocomplete="off" />


                    </div>




                    <div class="col-md-6">


                        <label for="password"
                               class="form-label fw-semibold">

                            Password

                        </label>


                        <InputText id="password"
                                   class="form-control rounded-3"
                                   type="password"
                                   @bind-Value="createModel.Password"
                                   autocomplete="new-password" />


                    </div>




                    <div class="col-md-6">


                        <label for="role"
                               class="form-label fw-semibold">

                            Role

                        </label>


                        <InputSelect id="role"
                                     class="form-select rounded-3"
                                     @bind-Value="createModel.Level">


                            <option value="2">
                                Administrator
                            </option>


                            <option value="1">
                                User
                            </option>


                        </InputSelect>


                    </div>


                </div>




                <div class="mt-4">


                    <button type="submit"
                            class="btn btn-primary px-4 rounded-pill shadow-sm">

                        Create User

                    </button>


                </div>


            </EditForm>


        </div>

    </div>





    

    <div class="card shadow-sm border-0 rounded-4">


        <div class="card-body p-4">


            <div class="d-flex justify-content-between align-items-center mb-3">


                <h2 class="fw-semibold mb-0">
                    Existing Users
                </h2>


                <span class="badge bg-primary rounded-pill">

                    @(users?.Count ?? 0) Users

                </span>


            </div>




            @if (users != null)
            {


                <div class="table-responsive">


                    <table class="table table-hover align-middle">


                        <thead class="table-dark">


                            <tr>

                                <th>
                                    Id
                                </th>

                                <th>
                                    Name
                                </th>

                                <th>
                                    Role
                                </th>

                            </tr>


                        </thead>



                        <tbody>


                            @foreach (User user in users)
                            {

                                <tr>

                                    <td>
                                        @user.Id
                                    </td>


                                    <td class="fw-semibold">
                                        @user.Name
                                    </td>


                                    <td>

                                        <span class="badge bg-secondary rounded-pill">

                                            @user.RoleName

                                        </span>

                                    </td>


                                </tr>

                            }


                        </tbody>


                    </table>


                </div>


            }


        </div>


    </div>


</div>

@code {
    [SupplyParameterFromForm]
    private CreateUserModel createModel { get; set; } = new();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private List<User>? users;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        if (HttpContext.Request.Method == HttpMethods.Post)
        {
            var result = await AuthService.CreateUserAsync(createModel.Name ?? "", createModel.Password ?? "", createModel.Level);
            isError = !result.Success;
            message = result.Success ? $"User '{createModel.Name}' created." : result.Error;
        }

        users = await AuthService.ListUsersAsync();
    }

    private class CreateUserModel
    {
        public string? Name { get; set; }
        public string? Password { get; set; }
        public int Level { get; set; } = 1;
    }
}
