@page "/login"
@using Microsoft.AspNetCore.Http.Extensions
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="container d-flex justify-content-center align-items-center min-vh-100">

    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 420px; width:100%;">

        <div class="card-body">

            <div class="text-center mb-4">

                <h1 class="fw-bold text-dark">
                    Welcome Back
                </h1>

                <p class="text-muted">
                    Login to Market Inventory Application
                </p>

            </div>


            @if (error != null)
            {
                <div class="alert alert-danger rounded-3">
                    @error
                </div>
            }



            <EditForm Model="model" method="post" FormName="login">


                <div class="mb-3">

                    <label for="username" class="form-label fw-semibold">
                        Username
                    </label>


                    <InputText id="username"
                               class="form-control form-control-lg rounded-3 shadow-sm"
                               @bind-Value="model.UserName"
                               autocomplete="username" />

                </div>




                <div class="mb-4">

                    <label for="password" class="form-label fw-semibold">
                        Password
                    </label>


                    <InputText id="password"
                               class="form-control form-control-lg rounded-3 shadow-sm"
                               type="password"
                               @bind-Value="model.Password"
                               autocomplete="current-password" />

                </div>



                <button type="submit"
                        class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm">

                    Log in

                </button>


            </EditForm>


        </div>

    </div>

</div>
@code {
    [SupplyParameterFromForm]
    private LoginModel model { get; set; } = new();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        if (HttpContext.Request.Method == HttpMethods.Post)
        {
            User? user = await AuthService.AuthenticateAsync(model.UserName ?? "", model.Password ?? "");
            if (user is null)
            {
                error = "Invalid username or password.";
                return;
            }

            await AuthService.SignInAsync(HttpContext, user);

            string? returnUrl = HttpContext.Request.Query["returnUrl"].ToString();
            if (string.IsNullOrEmpty(returnUrl))
            {
                returnUrl = HttpContext.Request.Query["ReturnUrl"].ToString();
            }
            if (!IsLocalUrl(returnUrl))
            {
                returnUrl = "/";
            }
            NavigationManager.NavigateTo(returnUrl);
        }
    }

    private static bool IsLocalUrl(string? url)
    {
        if (string.IsNullOrEmpty(url) || url[0] != '/')
        {
            return false;
        }
        return url.Length == 1 || (url[1] != '/' && url[1] != '\\');
    }

    private class LoginModel
    {
        public string? UserName { get; set; }
        public string? Password { get; set; }
    }
}
