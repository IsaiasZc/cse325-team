@page "/login"

@using Microsoft.AspNetCore.Http.Extensions

@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">

    <div class="card border-0 shadow-lg rounded-4"
         style="width: 100%; max-width: 430px;">

        <div class="card-body p-4 p-md-5">

            
            <div class="text-center mb-4">

                <div class="mb-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex
                                align-items-center justify-content-center"
                         style="width: 64px; height: 64px;">

                        <span class="text-primary fs-3 fw-bold">
                            MI
                        </span>

                    </div>
                </div>

                <h1 class="fw-bold text-dark mb-2">
                    Welcome Back
                </h1>

                <p class="text-muted mb-0">
                    Login to Market Inventory Application
                </p>

            </div>


           
            @if (error != null)
            {
                <div class="alert alert-danger rounded-3 border-0 mb-4"
                     role="alert">

                    @error

                </div>
            }


            
            <EditForm Model="model"
                      method="post"
                      FormName="login">

                
                <div class="mb-3">

                    <label for="username"
                           class="form-label fw-semibold text-dark">

                        Username

                    </label>

                    <InputText id="username"
                               class="form-control form-control-lg rounded-3"
                               @bind-Value="model.UserName"
                               autocomplete="username" />

                </div>


                
                <div class="mb-4">

                    <label for="password"
                           class="form-label fw-semibold text-dark">

                        Password

                    </label>

                    <InputText id="password"
                               class="form-control form-control-lg rounded-3"
                               type="password"
                               @bind-Value="model.Password"
                               autocomplete="current-password" />

                </div>


                
                <button type="submit"
                        class="btn btn-primary btn-lg w-100 rounded-pill fw-semibold shadow-sm">

                    Log in

                </button>


                
                <div class="text-center mt-4">

                    <span class="text-muted">
                        Don't have an account?
                    </span>

                    <button type="button"
                            class="btn btn-link text-decoration-none
                                   fw-semibold p-0 ms-1"
                            onclick="window.location.href='/register'">

                        Create new user

                    </button>

                </div>

            </EditForm>

        </div>

    </div>

</div>


@code {

    [SupplyParameterFromForm]
    private LoginModel model { get; set; } = new();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? error;


    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        if (HttpContext.Request.Method == HttpMethods.Post)
        {
            User? user = await AuthService.AuthenticateAsync(
                model.UserName ?? "",
                model.Password ?? ""
            );

            if (user is null)
            {
                error = "Invalid username or password.";
                return;
            }

            await AuthService.SignInAsync(
                HttpContext,
                user
            );

            string? returnUrl =
                HttpContext.Request.Query["returnUrl"].ToString();

            if (string.IsNullOrEmpty(returnUrl))
            {
                returnUrl =
                    HttpContext.Request.Query["ReturnUrl"].ToString();
            }

            if (!IsLocalUrl(returnUrl))
            {
                returnUrl = "/";
            }

            NavigationManager.NavigateTo(returnUrl);
        }
    }


    private static bool IsLocalUrl(string? url)
    {
        if (string.IsNullOrEmpty(url) || url[0] != '/')
        {
            return false;
        }

        return url.Length == 1 ||
               (url[1] != '/' && url[1] != '\\');
    }


    private class LoginModel
    {
        public string? UserName { get; set; }

        public string? Password { get; set; }
    }

}