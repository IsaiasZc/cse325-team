@page "/register"
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Create User</PageTitle>

<h1>Create a New Account</h1>

@if (error != null)
{
    <p class="text-danger">@error</p>
}

<EditForm Model="model" method="post" FormName="register" OnValidSubmit="HandleRegistration">
    <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <InputText id="username" class="form-control" @bind-Value="model.UserName" autocomplete="new-username" required />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" class="form-control" type="password" @bind-Value="model.Password" autocomplete="new-password" required />
    </div>
    <div class="mb-3">
        <label for="confirmPassword" class="form-label">Confirm Password</label>
        <InputText id="confirmPassword" class="form-control" type="password" @bind-Value="model.ConfirmPassword" autocomplete="new-password" required />
    </div>
    <div class="mb-3">
        <label for="level" class="form-label">Account Role</label>
        <InputSelect id="level" class="form-select" @bind-Value="model.Level">
            <option value="1">Standard User (Level 1)</option>
            <option value="2">Admin / Manager (Level 2)</option>
        </InputSelect>
    </div>
    <button type="submit" class="btn btn-success">Create Account</button>
    <a href="/login" class="btn btn-link">Cancel</a>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private RegisterModel model { get; set; } = default!;

    private string? error;

    protected override void OnInitialized()
    {
        model ??= new(); 
    }

    private async Task HandleRegistration()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(model.UserName) || string.IsNullOrWhiteSpace(model.Password))
        {
            error = "Username and password are required.";
            return;
        }

        if (model.Password != model.ConfirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        var result = await AuthService.CreateUserAsync(model.UserName, model.Password, model.Level);

        if (result.Success)
        {
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            error = result.Error;
        }
    }

    private class RegisterModel
    {
        public string? UserName { get; set; }
        public string? Password { get; set; }
        public string? ConfirmPassword { get; set; }
        public int Level { get; set; } = 1;
    }
}