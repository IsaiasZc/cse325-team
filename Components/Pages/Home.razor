@page "/"
@attribute [Authorize]
@inject HttpClient HttpClient
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Home</PageTitle>

<div class="main">
  <h1>Product</h1>

  <EditForm Model="@newProduct" 
    OnSubmit="@CreateProduct"
    class="product-form">
    <DataAnnotationsValidator />

    <div class="form-group">
      <label for="name">Name</label>
      <InputText id="name" class="form-control" @bind-Value="newProduct.Name" />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <InputTextArea id="description" class="form-control" @bind-Value="newProduct.Description" />
    </div>

    <div class="form-group">
      <label for="price">Price</label>
      <InputNumber id="price" class="form-control" @bind-Value="newProduct.Price" />
    </div>

    <div class="form-group">
      <label for="imageUrl">Image URL</label>
      <InputText id="imageUrl" class="form-control" @bind-Value="newProduct.ImageUrl" />
    </div>

    <button type="submit" class="btn btn-primary">@(isEditing ? "Update Product" : "Add Product")</button>
  </EditForm>

  <ul class="product-cards">
    @if (products != null)
    {
      @foreach (Product product in products)
      {
        @* <li style="background-image: url('@special.ImageUrl')"> *@
          <div class="product-info">
              <span class="title">@product.Name</span>
                  @product.Description
              <span class="price">@product.GetFormattedPrice()</span>
              <img src="@product.ImageUrl" alt="Image of @product.Name" style="max-width: 100%; height: auto;" />
              @* <span class="id">@product.Id</span> *@
              <button class="btn btn-primary" @onclick="@(() => EditProduct(product))">Edit</button>
              <button class="btn btn-danger" @onclick="@(() => DeleteProduct(product.Id))">Delete</button>
          </div>
        @* </li> *@
      }
    }
  </ul>
</div>

@code {
    private bool isEditing = false;
    private Product newProduct = new Product();
    List<Product> products = new List<Product>();

    protected override async Task OnInitializedAsync()
    {
        try
      {
          products = await HttpClient.GetFromJsonAsync<List<Product>>("products");
      }
      catch (Exception ex)
      {
          Console.WriteLine($"ERROR AL CARGAR PRODUCTOS: {ex.Message}");
      }
    }
    private async Task CreateProduct()
    {
        HttpResponseMessage response;
        if (isEditing)
        {
            response = await HttpClient.PutAsJsonAsync($"products/{newProduct.Id}", newProduct);
        }
        else
        {
            response = await HttpClient.PostAsJsonAsync("products", newProduct);
        }
        if (response.IsSuccessStatusCode)
        {
            newProduct = new Product();
            isEditing = false;
            products = await HttpClient.GetFromJsonAsync<List<Product>>("products");
        }
    }

    private void EditProduct(Product product)
    {
        isEditing = true;
        newProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            ImageUrl = product.ImageUrl
        };
    }

    private async Task DeleteProduct(int productId)
    {
        var response = await HttpClient.DeleteAsync($"products/{productId}");
        if (response.IsSuccessStatusCode)
        {
          products = await HttpClient.GetFromJsonAsync<List<Product>>("products");
        }
    }
}